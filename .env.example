# Backend secrets. Never import this file into the frontend.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by hosted Supabase.

# GITHUB PAGES
# ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io,http://localhost:8000,http://127.0.0.1:8000
# LOCALHOST
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
STORE_IP_HASH=false
IP_HASH_SALT=
# Set only after verifying your deployment's trusted proxy header.
TRUSTED_IP_HEADER=
BLOCK_DUPLICATE_IP_HASH=false
TEST_MODE=false
RATE_LIMIT_PER_MINUTE=120
# Public frontend settings: edit js/config.js (no build or .env loading).
# FUNCTION_URL=https://PROJECT.supabase.co/functions/v1/submit-response
